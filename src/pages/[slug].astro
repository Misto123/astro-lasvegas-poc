---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, getPostBySlug, type BlogPost } from '../lib/supabase';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt}>
  <article class="bg-white rounded-lg shadow-sm border p-8">
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        {post.title}
      </h1>
      <time class="text-gray-500">
        {new Date(post.created_at).toLocaleDateString('ru-RU', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        })}
      </time>
    </header>
    
    <div 
      class="prose prose-lg max-w-none prose-headings:font-display prose-a:text-blue-600 hover:prose-a:text-blue-700"
      set:html={post.content}
    />
  </article>
  
  <div class="mt-8">
    <a 
      href="/" 
      class="inline-block text-blue-600 hover:text-blue-700 font-medium"
    >
      ← Вернуться к статьям
    </a>
  </div>
</BaseLayout>

<style>
  .prose {
    color: #374151;
  }
  .prose h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.875rem;
    font-weight: 700;
  }
  .prose h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }
  .prose a {
    text-decoration: underline;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose img {
    margin: 2rem 0;
    border-radius: 0.5rem;
  }
</style>
